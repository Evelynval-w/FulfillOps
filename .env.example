# placeholders only, never real secrets
POSTGRES_USER=fulfillops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fulfillops
DATABASE_URL=postgresql://fulfillops:change-me@db:5432/fulfillops

# --- application settings (all optional; defaults shown) ---
POOL_SIZE=20
PORT=8080
# production (default) | development | test. Only "test" lets scripts/reset_test_data.py run.
APP_ENV=development
# Test-only switch: true makes /health/ready return 503 (used to simulate a broken release).
FAIL_READINESS=false
MIGRATIONS_DIR=db/migrations

# --- worker settings (all optional; only DATABASE_URL is required) ---
# WORKER_ID defaults to hostname-pid. POISON_CUSTOMER_ID is ignored when APP_ENV=production.
WORKER_POOL_SIZE=3
POLL_INTERVAL_S=0.5
LEASE_SECONDS=10
BACKOFF_BASE_S=2
BACKOFF_CAP_S=30
PROCESSING_SECONDS=0.5
# WORKER_ID=
# POISON_CUSTOMER_ID=
