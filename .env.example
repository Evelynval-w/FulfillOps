# placeholders only, never real secrets
POSTGRES_USER=fulfillops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fulfillops
DATABASE_URL=postgresql://fulfillops:change-me@db:5432/fulfillops

# --- application settings (all optional; defaults shown) ---
POOL_SIZE=20
PORT=8080
# production (default) | development | test. Only "test" lets scripts/reset-test-data run.
APP_ENV=development
# Test-only switch: true makes /health/ready return 503 (used to simulate a broken release).
FAIL_READINESS=false
MIGRATIONS_DIR=db/migrations
